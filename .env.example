# Required environment variables. Copy to .env and fill in.
# Read only through src/utils/env.py, never os.environ directly (spec: guides/zod-at-the-boundary).

# --- Google Cloud ---
# Created 2026-08-07 under the sawinyh.com org, billing linked, 35 APIs enabled.
GCP_PROJECT_ID=interchange-wzdx-0807
# us-central1 is not arbitrary: Model Armor must be in the same region as what it
# screens, and cross-region calls are not supported (SPEC 19.1).
GCP_REGION=us-central1

# --- Firestore ---
FIRESTORE_DATABASE=(default)

# --- Cloud Storage: feed body snapshots, reconciliation groupings, output feeds ---
GCS_BUCKET_SNAPSHOTS=
GCS_BUCKET_OUTPUT=

# --- Gemini, used ONLY for Tier 2 duplicate adjudication and notice drafting.
#     Never in the trust gate path. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
ADJUDICATION_PROMPT_VERSION=v1

# --- Agent Gateway / Model Armor. Screening fails closed: if unset or
#     unreachable, free text is redacted, never passed through. ---
# Verified working 2026-08-07 via sanitizeUserPrompt. Note the regional host.
MODEL_ARMOR_ENDPOINT=https://modelarmor.us-central1.rep.googleapis.com
MODEL_ARMOR_TEMPLATE=projects/interchange-wzdx-0807/locations/us-central1/templates/interchange-ingest
MODEL_ARMOR_POLICY_VERSION=interchange-ingest-v1

# --- Poll scheduling. The clamp is measured, not stylistic. ---
POLL_FLOOR_SECONDS=300
POLL_CEILING_SECONDS=3600

# --- Trust scorer. Bump when any rule threshold changes; recorded on every
#     transition so a decision can be explained after the fact. ---
RULESET_VERSION=v1

# --- Reconciler ---
MATCH_THRESHOLD_METRES=150
MIN_SYMMETRIC_COVERAGE=0.6
