{
  "name": "interchange-console",
  "version": "0.0.0",
  "private": true,
  "description": "Operator console for Interchange (spec 6.9). Next.js on Cloud Run, Firebase Auth, Firestore.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && eslint .",
