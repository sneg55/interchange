{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  // Biome config for AI-agent-driven TypeScript codebases. Pairs with
  // eslint.config.mjs - Biome handles fast syntactic rules + formatting;
  // ESLint keeps type-aware and plugin-specific rules.
  // Rationale and tier-by-tier breakdown: guides/lint-rules-for-ai.md.
  // The repo root is one level up: this is the console workspace of a polyglot
  // monorepo whose Python side lives in ../src. Without an explicit root Biome
  // looks for an ignore file beside this config and errors out.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    // tsconfig.json is excluded because Next.js owns its formatting: `next dev`
    // and `next build` rewrite the file to add compiler settings, expanding the
    // arrays Biome then wants collapsed. Left in, `npm run lint` fails after
    // every build, which trains the reader to ignore it.
    "includes": [
      "**",
      "!**/dist/**",
      "!**/build/**",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": { "ignoreRestSiblings": true }
        },
        "noUnusedPrivateClassMembers": "error",
        "noUnreachable": "error",
        "noConstantCondition": "error",
        "noConstantMathMinMaxClamp": "error",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDebugger": "error",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["warn", "error"] }
        },
        "noEmptyBlockStatements": "error",
        "noDoubleEquals": "error",
        "noSelfCompare": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noFallthroughSwitchClause": "error",
        "noVar": "error"
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        "useConsistentBuiltinInstantiation": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useThrowOnlyError": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lodash": "Use native JS or lodash-es.",
              "moment": "Use date-fns or Temporal.",
              "axios": "Use fetch."
            }
          }
        }
      },
      "complexity": {
        "useOptionalChain": "error",
        "noUselessTypeConstraint": "error",
        "noUselessConstructor": "error",
        "noUselessRename": "error",
        "noUselessTernary": "error",
        "noBannedTypes": "error"
      },
      "security": {
        "noGlobalEval": "error"
      },
      "performance": {
        "noDelete": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{test,spec}.{ts,tsx}", "**/tests/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
